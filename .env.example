# Formspree (static hosting) — ID from https://formspree.io/forms → your form → URL ends with /f/THIS_PART
NEXT_PUBLIC_FORMSPREE_FORM_ID=xeedjrey

# reCAPTCHA v3 site key (public) — create at https://www.google.com/recaptcha/admin
# Secret key goes in Formspree form settings, not here
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Optional: only needed for local dev with `pnpm dev` and /api/contact (Resend)
RESEND_API_KEY=your_resend_api_key
CONTACT_EMAIL=your_email@example.com
